  "totalSec": 469,
  "chunks": [
    {
      "index": 0,
      "text": "Bienvenidos a una práctica de descanso profundo.",
      "file": "c000.ogg",
      "durationSec": 6.288
    },
    {
      "index": 1,
      "text": "Acuéstese boca arriba si puede.",
      "file": "c001.ogg",
      "durationSec": 4.824
    },
    {
      "index": 2,
      "text": "Apoye la cabeza y las rodillas si eso ayuda.",
      "file": "c002.ogg",
      "durationSec": 5.88
    },
    {
      "index": 3,
      "text": "Deje que los brazos descansen a los lados, con las palmas suaves.",
      "file": "c003.ogg",
      "durationSec": 8.04
    },
    {
      "index": 4,
      "text": "Cierra los ojos.",
      "file": "c004.ogg",
      "durationSec": 3.648
    },
    {
      "index": 5,
      "text": "No hay ningún otro lugar donde estar.",
      "file": "c005.ogg",
      "durationSec": 5.088
    },
    {
      "index": 6,
      "text": "[pausa:23]",
      "file": "c006.ogg",
      "durationSec": 4.152
    },
    {
      "index": 7,
      "text": "Siente los puntos de contacto con el suelo o la cama.",
      "file": "c007.ogg",
      "durationSec": 6.648
    },
    {
      "index": 8,
      "text": "Tacones. Caderas. Omóplatos. Cabeza.",
      "file": "c008.ogg",
      "durationSec": 10.944
    },
    {
      "index": 9,
      "text": "Permitir que el cuerpo sea sostenido.",
      "file": "c009.ogg",
      "durationSec": 5.232
    },
    {
      "index": 10,
      "text": "[pausa:23]",
      "file": "c010.ogg",
      "durationSec": 4.152
    },
    {
      "index": 11,
      "text": "Note la respiración natural.",
      "file": "c011.ogg",
      "durationSec": 4.536
    },
    {
      "index": 12,
      "text": "No es necesario cambiarlo.",
      "file": "c012.ogg",
      "durationSec": 4.44
    },
    {
      "index": 13,
      "text": "Llega la inhalación.",
      "file": "c013.ogg",
      "durationSec": 3.672
    },
    {
      "index": 14,
      "text": "Exhala las hojas.",
      "file": "c014.ogg",
      "durationSec": 3.672
    },
    {
      "index": 15,
      "text": "[pausa:25]",
      "file": "c015.ogg",
      "durationSec": 4.104
    },
    {
      "index": 16,
      "text": "Si la mente está ocupada, eso está permitido.",
      "file": "c016.ogg",
      "durationSec": 6.528
    },
    {
      "index": 17,
      "text": "Puedes descansar de todos modos.",
      "file": "c017.ogg",
      "durationSec": 4.848
    },
    {
      "index": 18,
      "text": "Simplemente sigue volviendo a la sensación.",
      "file": "c018.ogg",
      "durationSec": 5.712
    },
    {
      "index": 19,
      "text": "[pausa:23]",
      "file": "c019.ogg",
      "durationSec": 4.152
    },
    {
      "index": 20,
      "text": "Lleva la conciencia al pie derecho.",
      "file": "c020.ogg",
      "durationSec": 4.872
    },
    {
      "index": 21,
      "text": "Dedos de los pies. Único. Tacón.",
      "file": "c021.ogg",
      "durationSec": 8.4
    },
    {
      "index": 22,
      "text": "[pausa:21]",
      "file": "c022.ogg",
      "durationSec": 3.912
    },
    {
      "index": 23,
      "text": "Pierna derecha.",
      "file": "c023.ogg",
      "durationSec": 3.192
    },
    {
      "index": 24,
      "text": "Rodilla.",
      "file": "c024.ogg",
      "durationSec": 2.664
    },
    {
      "index": 25,
      "text": "Hermético.",
      "file": "c025.ogg",
      "durationSec": 2.88
    },
    {
      "index": 26,
      "text": "[pausa:21]",
      "file": "c026.ogg",
      "durationSec": 3.912
    },
    {
      "index": 27,
      "text": "Cadera derecha.",
      "file": "c027.ogg",
      "durationSec": 3.192
    },
    {
      "index": 28,
      "text": "Pierna derecha entera, pesada y tranquila.",
      "file": "c028.ogg",
      "durationSec": 6.096
    },
    {
      "index": 29,
      "text": "[pausa:23]",
      "file": "c029.ogg",
      "durationSec": 4.152
    },
    {
      "index": 30,
      "text": "Pie izquierdo.",
      "file": "c030.ogg",
      "durationSec": 3.12
    },
    {
      "index": 31,
      "text": "Dedos de los pies. Único. Tacón.",
      "file": "c031.ogg",
      "durationSec": 8.4
    },
    {
      "index": 32,
      "text": "[pausa:21]",
      "file": "c032.ogg",
      "durationSec": 3.912
    },
    {
      "index": 33,
      "text": "Pierna izquierda.",
      "file": "c033.ogg",
      "durationSec": 3.288
    },
    {
      "index": 34,
      "text": "Rodilla.",
      "file": "c034.ogg",
      "durationSec": 2.664
    },
    {
      "index": 35,
      "text": "Hermético.",
      "file": "c035.ogg",
      "durationSec": 2.88
    },
    {
      "index": 36,
      "text": "[pausa:21]",
      "file": "c036.ogg",
      "durationSec": 3.912
    },
    {
      "index": 37,
      "text": "Cadera izquierda.",
      "file": "c037.ogg",
      "durationSec": 3.312
    },
    {
      "index": 38,
      "text": "Pierna izquierda entera, pesada y silenciosa.",
      "file": "c038.ogg",
      "durationSec": 6.432
    },
    {
      "index": 39,
      "text": "[pausa:23]",
      "file": "c039.ogg",
      "durationSec": 4.152
    },
    {
      "index": 40,
      "text": "Pelvis y vientre bajo.",
      "file": "c040.ogg",
      "durationSec": 3.888
    },
    {
      "index": 41,
      "text": "Suave.",
      "file": "c041.ogg",
      "durationSec": 2.592
    },
    {
      "index": 42,
      "text": "[pausa:21]",
      "file": "c042.ogg",
      "durationSec": 3.912
    },
    {
      "index": 43,
      "text": "Pecho subiendo y bajando.",
      "file": "c043.ogg",
      "durationSec": 4.056
    },
    {
      "index": 44,
      "text": "Espacio del corazón abierto y fácil.",
      "file": "c044.ogg",
      "durationSec": 5.232
    },
    {
      "index": 45,
      "text": "[pausa:23]",
      "file": "c045.ogg",
      "durationSec": 4.152
    },
    {
      "index": 46,
      "text": "Derecha.",
      "file": "c046.ogg",
      "durationSec": 2.688
    },
    {
      "index": 47,
      "text": "Dedos. Palmera. Muñeca.",
      "file": "c047.ogg",
      "durationSec": 7.728
    },
    {
      "index": 48,
      "text": "[pausa:14]",
      "file": "c048.ogg",
      "durationSec": 4.032
    },
    {
      "index": 49,
      "text": "Brazo derecho. Codo. Hombro.",
      "file": "c049.ogg",
      "durationSec": 7.776
    },
    {
      "index": 50,
      "text": "[pausa:21]",
      "file": "c050.ogg",
      "durationSec": 3.912
    },
    {
      "index": 51,
      "text": "Mano izquierda.",
      "file": "c051.ogg",
      "durationSec": 3.264
    },
    {
      "index": 52,
      "text": "Dedos. Palmera. Muñeca.",
      "file": "c052.ogg",
      "durationSec": 7.728
    },
    {
      "index": 53,
      "text": "[pausa:14]",
      "file": "c053.ogg",
      "durationSec": 4.032
    },
    {
      "index": 54,
      "text": "Brazo izquierdo. Codo. Hombro.",
      "file": "c054.ogg",
      "durationSec": 7.824
    },
    {
      "index": 55,
      "text": "[pausa:23]",
      "file": "c055.ogg",
      "durationSec": 4.152
    },
    {
      "index": 56,
      "text": "Garganta suave.",
      "file": "c056.ogg",
      "durationSec": 3.312
    },
    {
      "index": 57,
      "text": "Mandíbula aflojada.",
      "file": "c057.ogg",
      "durationSec": 3.792
    },
    {
      "index": 58,
      "text": "Lengua en reposo.",
      "file": "c058.ogg",
      "durationSec": 3.408
    },
    {
      "index": 59,
      "text": "[pausa:21]",
      "file": "c059.ogg",
      "durationSec": 3.912
    },
    {
      "index": 60,
      "text": "Ojos descansando en sus órbitas.",
      "file": "c060.ogg",
      "durationSec": 4.944
    },
    {
      "index": 61,
      "text": "Frente lisa.",
      "file": "c061.ogg",
      "durationSec": 2.928
    },
    {
      "index": 62,
      "text": "Cuero cabelludo y coronilla de la cabeza.",
      "file": "c062.ogg",
      "durationSec": 5.28
    },
    {
      "index": 63,
      "text": "[pausa:23]",
      "file": "c063.ogg",
      "durationSec": 4.152
    },
    {
      "index": 64,
      "text": "Siente todo el cuerpo como un campo de quietud.",
      "file": "c064.ogg",
      "durationSec": 6.12
    },
    {
      "index": 65,
      "text": "La respiración se mueve a través de él como una marea tranquila.",
      "file": "c065.ogg",
      "durationSec": 7.464
    },
    {
      "index": 66,
      "text": "[pausa:62]",
      "file": "c066.ogg",
      "durationSec": 4.56
    },
    {
      "index": 67,
      "text": "Quédate con todo el cuerpo.",
      "file": "c067.ogg",
      "durationSec": 4.104
    },
    {
      "index": 68,
      "text": "[pausa:105]",
      "file": "c068.ogg",
      "durationSec": 4.32
    },
    {
      "index": 69,
      "text": "Suave. Espacioso. Aún.",
      "file": "c069.ogg",
      "durationSec": 7.776
    },
    {
      "index": 70,
      "text": "[pausa:55]",
      "file": "c070.ogg",
      "durationSec": 4.584
    },
    {
      "index": 71,
      "text": "Si aparece un pensamiento, déjalo pasar como una nube.",
      "file": "c071.ogg",
      "durationSec": 7.56
    },
    {
      "index": 72,
      "text": "[pausa:50]",
      "file": "c072.ogg",
      "durationSec": 3.984
    },
    {
      "index": 73,
      "text": "Vuelve a la sensación de estar retenido.",
      "file": "c073.ogg",
      "durationSec": 5.112
    },
    {
      "index": 74,
      "text": "[pausa:55]",
      "file": "c074.ogg",
      "durationSec": 4.584
    },
    {
      "index": 75,
      "text": "Descansa aquí.",
      "file": "c075.ogg",
      "durationSec": 3.216
    },
    {
      "index": 76,
      "text": "Nada que solucionar.",
      "file": "c076.ogg",
      "durationSec": 3.72
    },
    {
      "index": 77,
      "text": "Nada que completar.",
      "file": "c077.ogg",
      "durationSec": 3.648
    },
    {
      "index": 78,
      "text": "[pausa:110]",
      "file": "c078.ogg",
      "durationSec": 4.416
    },
    {
      "index": 79,
      "text": "Si te desvías, está bien.",
      "file": "c079.ogg",
      "durationSec": 4.776
    },
    {
      "index": 80,
      "text": "Si estás atento, eso también está bien.",
      "file": "c080.ogg",
      "durationSec": 6.0
    },
    {
      "index": 81,
      "text": "Ambos son descanso.",
      "file": "c081.ogg",
      "durationSec": 3.576
    },
    {
      "index": 82,
      "text": "[pausa:130]",
      "file": "c082.ogg",
      "durationSec": 4.416
    },
    {
      "index": 83,
      "text": "Descansar.",
      "file": "c083.ogg",
      "durationSec": 2.976
    },
    {
      "index": 84,
      "text": "[pausa:115]",
      "file": "c084.ogg",
      "durationSec": 4.368
    },
    {
      "index": 85,
      "text": "Comienza a notar la respiración nuevamente.",
      "file": "c085.ogg",
      "durationSec": 5.64
    },
    {
      "index": 86,
      "text": "Un poco más vívido ahora.",
      "file": "c086.ogg",
      "durationSec": 4.224
    },
    {
      "index": 87,
      "text": "[pausa:23]",
      "file": "c087.ogg",
      "durationSec": 4.152
    },
    {
      "index": 88,
      "text": "Siente la habitación que te rodea.",
      "file": "c088.ogg",
      "durationSec": 4.872
    },
    {
      "index": 89,
      "text": "Suena cerca y lejos.",
      "file": "c089.ogg",
      "durationSec": 4.032
    },
    {
      "index": 90,
      "text": "[pausa:21]",
      "file": "c090.ogg",
      "durationSec": 3.912
    },
    {
      "index": 91,
      "text": "Mueve los dedos.",
      "file": "c091.ogg",
      "durationSec": 3.288
    },
    {
      "index": 92,
      "text": "Mueve los dedos de los pies.",
      "file": "c092.ogg",
      "durationSec": 4.2
    },
    {
      "index": 93,
      "text": "Enrolla las muñecas y los tobillos si quieres.",
      "file": "c093.ogg",
      "durationSec": 6.048
    },
    {
      "index": 94,
      "text": "[pausa:21]",
      "file": "c094.ogg",
      "durationSec": 3.912
    },
    {
      "index": 95,
      "text": "Respire más profundamente.",
      "file": "c095.ogg",
      "durationSec": 4.44
    },
    {
      "index": 96,
      "text": "Y un largo suspiro.",
      "file": "c096.ogg",
      "durationSec": 3.816
    },
    {
      "index": 97,
      "text": "Cuando estés listo, abre los ojos.",
      "file": "c097.ogg",
      "durationSec": 5.352
    },
    {
      "index": 98,
      "text": "Regrese lentamente.",
      "file": "c098.ogg",
      "durationSec": 3.744
    },
    {
      "index": 99,
      "text": "Lleva contigo un poco de esta tranquilidad.",
      "file": "c099.ogg",
      "durationSec": 5.832
    }
  ]
}
