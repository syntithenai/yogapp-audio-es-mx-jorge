  "totalSec": 298,
  "chunks": [
    {
      "index": 0,
      "text": "Bienvenido.",
      "file": "c000.ogg",
      "durationSec": 2.88
    },
    {
      "index": 1,
      "text": "Tómese el tiempo para llegar.",
      "file": "c001.ogg",
      "durationSec": 4.296
    },
    {
      "index": 2,
      "text": "Siéntate o acuéstate con apoyo.",
      "file": "c002.ogg",
      "durationSec": 5.016
    },
    {
      "index": 3,
      "text": "Cierra los ojos si te sientes seguro.",
      "file": "c003.ogg",
      "durationSec": 5.16
    },
    {
      "index": 4,
      "text": "Siente el contacto con el suelo.",
      "file": "c004.ogg",
      "durationSec": 4.68
    },
    {
      "index": 5,
      "text": "Inhale lentamente.",
      "file": "c005.ogg",
      "durationSec": 3.72
    },
    {
      "index": 6,
      "text": "Exhale más tiempo.",
      "file": "c006.ogg",
      "durationSec": 3.624
    },
    {
      "index": 7,
      "text": "[pausa:27]",
      "file": "c007.ogg",
      "durationSec": 4.104
    },
    {
      "index": 8,
      "text": "De nuevo.",
      "file": "c008.ogg",
      "durationSec": 2.64
    },
    {
      "index": 9,
      "text": "[pausa:27]",
      "file": "c009.ogg",
      "durationSec": 4.104
    },
    {
      "index": 10,
      "text": "Deja caer los hombros.",
      "file": "c010.ogg",
      "durationSec": 4.08
    },
    {
      "index": 11,
      "text": "Deja que la barriga se ablande.",
      "file": "c011.ogg",
      "durationSec": 4.512
    },
    {
      "index": 12,
      "text": "[pausa:34]",
      "file": "c012.ogg",
      "durationSec": 4.344
    },
    {
      "index": 13,
      "text": "Ofreceremos amabilidad en un círculo cada vez más amplio.",
      "file": "c013.ogg",
      "durationSec": 7.128
    },
    {
      "index": 14,
      "text": "Las frases son invitaciones, no órdenes.",
      "file": "c014.ogg",
      "durationSec": 6.288
    },
    {
      "index": 15,
      "text": "[pausa:34]",
      "file": "c015.ogg",
      "durationSec": 4.344
    },
    {
      "index": 16,
      "text": "Hacia ti mismo.",
      "file": "c016.ogg",
      "durationSec": 3.24
    },
    {
      "index": 17,
      "text": "¿Puedo estar a salvo?",
      "file": "c017.ogg",
      "durationSec": 3.48
    },
    {
      "index": 18,
      "text": "[pausa:27]",
      "file": "c018.ogg",
      "durationSec": 4.104
    },
    {
      "index": 19,
      "text": "Que esté bien.",
      "file": "c019.ogg",
      "durationSec": 3.0
    },
    {
      "index": 20,
      "text": "[pausa:27]",
      "file": "c020.ogg",
      "durationSec": 4.104
    },
    {
      "index": 21,
      "text": "Que pueda vivir con tranquilidad.",
      "file": "c021.ogg",
      "durationSec": 4.584
    },
    {
      "index": 22,
      "text": "[pausa:41]",
      "file": "c022.ogg",
      "durationSec": 4.272
    },
    {
      "index": 23,
      "text": "De nuevo, lentamente.",
      "file": "c023.ogg",
      "durationSec": 4.224
    },
    {
      "index": 24,
      "text": "¿Puedo estar a salvo?",
      "file": "c024.ogg",
      "durationSec": 3.48
    },
    {
      "index": 25,
      "text": "Que esté bien.",
      "file": "c025.ogg",
      "durationSec": 3.0
    },
    {
      "index": 26,
      "text": "Que pueda vivir con tranquilidad.",
      "file": "c026.ogg",
      "durationSec": 4.584
    },
    {
      "index": 27,
      "text": "[pausa:69]",
      "file": "c027.ogg",
      "durationSec": 4.416
    },
    {
      "index": 28,
      "text": "Recuerde a un amigo o alguien por quien sea fácil preocuparse.",
      "file": "c028.ogg",
      "durationSec": 7.728
    },
    {
      "index": 29,
      "text": "Que estés a salvo.",
      "file": "c029.ogg",
      "durationSec": 3.48
    },
    {
      "index": 30,
      "text": "[pausa:27]",
      "file": "c030.ogg",
      "durationSec": 4.104
    },
    {
      "index": 31,
      "text": "Que estés bien.",
      "file": "c031.ogg",
      "durationSec": 3.048
    },
    {
      "index": 32,
      "text": "[pausa:27]",
      "file": "c032.ogg",
      "durationSec": 4.104
    },
    {
      "index": 33,
      "text": "Que vivas con tranquilidad.",
      "file": "c033.ogg",
      "durationSec": 4.128
    },
    {
      "index": 34,
      "text": "[pausa:69]",
      "file": "c034.ogg",
      "durationSec": 4.416
    },
    {
      "index": 35,
      "text": "Recuerda a una persona neutral. Alguien a quien apenas conoces.",
      "file": "c035.ogg",
      "durationSec": 9.432
    },
    {
      "index": 36,
      "text": "Que estés a salvo.",
      "file": "c036.ogg",
      "durationSec": 3.48
    },
    {
      "index": 37,
      "text": "Que estés bien.",
      "file": "c037.ogg",
      "durationSec": 3.048
    },
    {
      "index": 38,
      "text": "Que vivas con tranquilidad.",
      "file": "c038.ogg",
      "durationSec": 4.128
    },
    {
      "index": 39,
      "text": "[pausa:69]",
      "file": "c039.ogg",
      "durationSec": 4.416
    },
    {
      "index": 40,
      "text": "Si le parece posible, incluya a alguien difícil, a la ligera.",
      "file": "c040.ogg",
      "durationSec": 8.424
    },
    {
      "index": 41,
      "text": "O vuelve a ti mismo si hoy te resulta más prudente.",
      "file": "c041.ogg",
      "durationSec": 6.528
    },
    {
      "index": 42,
      "text": "Que estés libre de sufrimiento.",
      "file": "c042.ogg",
      "durationSec": 4.536
    },
    {
      "index": 43,
      "text": "[pausa:55]",
      "file": "c043.ogg",
      "durationSec": 4.584
    },
    {
      "index": 44,
      "text": "Ampliarse a todos los seres, cercanos y lejanos.",
      "file": "c044.ogg",
      "durationSec": 6.912
    },
    {
      "index": 45,
      "text": "Que todos los seres estén a salvo.",
      "file": "c045.ogg",
      "durationSec": 4.848
    },
    {
      "index": 46,
      "text": "[pausa:34]",
      "file": "c046.ogg",
      "durationSec": 4.344
    },
    {
      "index": 47,
      "text": "Que todos los seres estén bien.",
      "file": "c047.ogg",
      "durationSec": 4.464
    },
    {
      "index": 48,
      "text": "[pausa:34]",
      "file": "c048.ogg",
      "durationSec": 4.344
    },
    {
      "index": 49,
      "text": "Que todos los seres vivan con tranquilidad.",
      "file": "c049.ogg",
      "durationSec": 5.52
    },
    {
      "index": 50,
      "text": "[pausa:82]",
      "file": "c050.ogg",
      "durationSec": 4.416
    },
    {
      "index": 51,
      "text": "Regresa a tu propio cuerpo y respira.",
      "file": "c051.ogg",
      "durationSec": 5.232
    },
    {
      "index": 52,
      "text": "Descansa en el resplandor de las frases.",
      "file": "c052.ogg",
      "durationSec": 5.472
    },
    {
      "index": 53,
      "text": "[pausa:150]",
      "file": "c053.ogg",
      "durationSec": 4.56
    },
    {
      "index": 54,
      "text": "Nada que forzar. La suavidad es suficiente.",
      "file": "c054.ogg",
      "durationSec": 7.488
    },
    {
      "index": 55,
      "text": "[pausa:137]",
      "file": "c055.ogg",
      "durationSec": 4.968
    },
    {
      "index": 56,
      "text": "[pausa:41]",
      "file": "c056.ogg",
      "durationSec": 4.272
    },
    {
      "index": 57,
      "text": "Comience a profundizar la respiración.",
      "file": "c057.ogg",
      "durationSec": 5.208
    },
    {
      "index": 58,
      "text": "Descansa aquí.",
      "file": "c058.ogg",
      "durationSec": 3.216
    },
    {
      "index": 59,
      "text": "[pausa:26]",
      "file": "c059.ogg",
      "durationSec": 4.224
    },
    {
      "index": 60,
      "text": "Siente la habitación de nuevo.",
      "file": "c060.ogg",
      "durationSec": 4.488
    },
    {
      "index": 61,
      "text": "Mueve los dedos de las manos y de los pies.",
      "file": "c061.ogg",
      "durationSec": 5.472
    },
    {
      "index": 62,
      "text": "Cuando esté listo, abre los ojos.",
      "file": "c062.ogg",
      "durationSec": 5.208
    },
    {
      "index": 63,
      "text": "Avance lentamente hacia lo que viene a continuación.",
      "file": "c063.ogg",
      "durationSec": 6.168
    }
  ]
}
