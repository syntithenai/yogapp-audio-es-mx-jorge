{
  "id": "self-compassion-10",
  "voiceId": "es-mx-jorge",
  "edgeVoice": "es-MX-JorgeNeural",
  "rate": "-42%",
  "pitch": "-12Hz",
  "totalSec": 188,
  "chunks": [
    {
      "index": 0,
      "text": "Bienvenido.",
      "file": "c000.ogg",
      "durationSec": 2.88
    },
    {
      "index": 1,
      "text": "Tómese el tiempo para llegar.",
      "file": "c001.ogg",
      "durationSec": 4.296
    },
    {
      "index": 2,
      "text": "Siéntate o acuéstate con apoyo.",
      "file": "c002.ogg",
      "durationSec": 5.016
    },
    {
      "index": 3,
      "text": "Cierra los ojos si te sientes seguro.",
      "file": "c003.ogg",
      "durationSec": 5.16
    },
    {
      "index": 4,
      "text": "Siente el contacto con el suelo.",
      "file": "c004.ogg",
      "durationSec": 4.68
    },
    {
      "index": 5,
      "text": "Inhale lentamente.",
      "file": "c005.ogg",
      "durationSec": 3.72
    },
    {
      "index": 6,
      "text": "Exhale más tiempo.",
      "file": "c006.ogg",
      "durationSec": 3.624
    },
    {
      "index": 7,
      "text": "[pausa:26]",
      "file": "c007.ogg",
      "durationSec": 4.224
    },
    {
      "index": 8,
      "text": "De nuevo.",
      "file": "c008.ogg",
      "durationSec": 2.64
    },
    {
      "index": 9,
      "text": "[pausa:26]",
      "file": "c009.ogg",
      "durationSec": 4.224
    },
    {
      "index": 10,
      "text": "Deja caer los hombros.",
      "file": "c010.ogg",
      "durationSec": 4.08
    },
    {
      "index": 11,
      "text": "Deja que la barriga se ablande.",
      "file": "c011.ogg",
      "durationSec": 4.512
    },
    {
      "index": 12,
      "text": "[pausa:32]",
      "file": "c012.ogg",
      "durationSec": 4.416
    },
    {
      "index": 13,
      "text": "Mano en el corazón, si eso ayuda.",
      "file": "c013.ogg",
      "durationSec": 5.472
    },
    {
      "index": 14,
      "text": "Observa tu estado sin juzgar.",
      "file": "c014.ogg",
      "durationSec": 4.584
    },
    {
      "index": 15,
      "text": "[pausa:32]",
      "file": "c015.ogg",
      "durationSec": 4.416
    },
    {
      "index": 16,
      "text": "Este es un momento de sufrimiento o de tensión humana común y corriente.",
      "file": "c016.ogg",
      "durationSec": 8.352
    },
    {
      "index": 17,
      "text": "Otros también sienten esto.",
      "file": "c017.ogg",
      "durationSec": 4.32
    },
    {
      "index": 18,
      "text": "[pausa:39]",
      "file": "c018.ogg",
      "durationSec": 4.272
    },
    {
      "index": 19,
      "text": "Que pueda ser amable conmigo mismo en este momento.",
      "file": "c019.ogg",
      "durationSec": 6.288
    },
    {
      "index": 20,
      "text": "[pausa:32]",
      "file": "c020.ogg",
      "durationSec": 4.416
    },
    {
      "index": 21,
      "text": "Que me acepte tal como soy.",
      "file": "c021.ogg",
      "durationSec": 4.104
    },
    {
      "index": 22,
      "text": "[pausa:32]",
      "file": "c022.ogg",
      "durationSec": 4.416
    },
    {
      "index": 23,
      "text": "Que pueda darme la compasión que necesito.",
      "file": "c023.ogg",
      "durationSec": 5.328
    },
    {
      "index": 24,
      "text": "[pausa:39]",
      "file": "c024.ogg",
      "durationSec": 4.272
    },
    {
      "index": 25,
      "text": "Repite las frases que aterrizan. Deja los que no.",
      "file": "c025.ogg",
      "durationSec": 7.992
    },
    {
      "index": 26,
      "text": "[pausa:52]",
      "file": "c026.ogg",
      "durationSec": 4.584
    },
    {
      "index": 27,
      "text": "Imagínese hablar consigo mismo como lo haría un amigo sabio.",
      "file": "c027.ogg",
      "durationSec": 7.536
    },
    {
      "index": 28,
      "text": "¿Qué tono usarían?",
      "file": "c028.ogg",
      "durationSec": 3.456
    },
    {
      "index": 29,
      "text": "Ofrécete ese tono ahora.",
      "file": "c029.ogg",
      "durationSec": 4.416
    },
    {
      "index": 30,
      "text": "[pausa:65]",
      "file": "c030.ogg",
      "durationSec": 4.512
    },
    {
      "index": 31,
      "text": "Inhala bondad.",
      "file": "c031.ogg",
      "durationSec": 3.408
    },
    {
      "index": 32,
      "text": "Exhala dureza.",
      "file": "c032.ogg",
      "durationSec": 3.288
    },
    {
      "index": 33,
      "text": "[pausa:78]",
      "file": "c033.ogg",
      "durationSec": 4.44
    },
    {
      "index": 34,
      "text": "[pausa:39]",
      "file": "c034.ogg",
      "durationSec": 4.272
    },
    {
      "index": 35,
      "text": "Comience a profundizar la respiración.",
      "file": "c035.ogg",
      "durationSec": 5.208
    },
    {
      "index": 36,
      "text": "Siente la habitación de nuevo.",
      "file": "c036.ogg",
      "durationSec": 4.488
    },
    {
      "index": 37,
      "text": "Mueve los dedos de las manos y de los pies.",
      "file": "c037.ogg",
      "durationSec": 5.472
    },
    {
      "index": 38,
      "text": "Cuando esté listo, abre los ojos.",
      "file": "c038.ogg",
      "durationSec": 5.208
    },
    {
      "index": 39,
      "text": "Avance lentamente hacia lo que viene a continuación.",
      "file": "c039.ogg",
      "durationSec": 6.168
    }
  ]
}
