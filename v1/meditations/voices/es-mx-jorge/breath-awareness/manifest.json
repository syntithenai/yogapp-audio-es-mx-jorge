{
  "id": "breath-awareness",
  "voiceId": "es-mx-jorge",
  "edgeVoice": "es-MX-JorgeNeural",
  "rate": "-42%",
  "pitch": "-12Hz",
  "totalSec": 132,
  "chunks": [
    {
      "index": 0,
      "text": "Adopte una postura estable.",
      "file": "c000.ogg",
      "durationSec": 4.416
    },
    {
      "index": 1,
      "text": "Lomo alto pero no rígido.",
      "file": "c001.ogg",
      "durationSec": 4.464
    },
    {
      "index": 2,
      "text": "Presta atención a la respiración tal como es.",
      "file": "c002.ogg",
      "durationSec": 6.072
    },
    {
      "index": 3,
      "text": "No lo cambies todavía. Sólo mira.",
      "file": "c003.ogg",
      "durationSec": 6.672
    },
    {
      "index": 4,
      "text": "Siente el frescor de la inhalación en las fosas nasales.",
      "file": "c004.ogg",
      "durationSec": 6.984
    },
    {
      "index": 5,
      "text": "Siente el calor de la exhalación.",
      "file": "c005.ogg",
      "durationSec": 4.752
    },
    {
      "index": 6,
      "text": "O observe el ascenso y descenso del vientre.",
      "file": "c006.ogg",
      "durationSec": 5.64
    },
    {
      "index": 7,
      "text": "Elija un lugar para descansar su atención.",
      "file": "c007.ogg",
      "durationSec": 5.832
    },
    {
      "index": 8,
      "text": "Cuando la mente divaga, por favor regresa.",
      "file": "c008.ogg",
      "durationSec": 5.832
    },
    {
      "index": 9,
      "text": "Sin juicio. Sólo regresa.",
      "file": "c009.ogg",
      "durationSec": 6.168
    },
    {
      "index": 10,
      "text": "Ahora, si te resulta fácil, cuenta los ciclos suaves.",
      "file": "c010.ogg",
      "durationSec": 7.824
    },
    {
      "index": 11,
      "text": "Inhalar. Uno.",
      "file": "c011.ogg",
      "durationSec": 5.016
    },
    {
      "index": 12,
      "text": "Exhalar. Uno.",
      "file": "c012.ogg",
      "durationSec": 5.112
    },
    {
      "index": 13,
      "text": "Inhalar. Dos.",
      "file": "c013.ogg",
      "durationSec": 5.184
    },
    {
      "index": 14,
      "text": "Exhalar. Dos.",
      "file": "c014.ogg",
      "durationSec": 5.28
    },
    {
      "index": 15,
      "text": "Continúe hasta cinco, luego comience de nuevo en uno.",
      "file": "c015.ogg",
      "durationSec": 7.08
    },
    {
      "index": 16,
      "text": "Si pierdes la cuenta, empieza de nuevo con amabilidad.",
      "file": "c016.ogg",
      "durationSec": 7.416
    },
    {
      "index": 17,
      "text": "El regreso es la práctica.",
      "file": "c017.ogg",
      "durationSec": 4.344
    },
    {
      "index": 18,
      "text": "Deja que la respiración sea natural. Sin tensión.",
      "file": "c018.ogg",
      "durationSec": 8.352
    },
    {
      "index": 19,
      "text": "Unos ciclos más en silencio.",
      "file": "c019.ogg",
      "durationSec": 4.464
    },
    {
      "index": 20,
      "text": "Liberar el conteo.",
      "file": "c020.ogg",
      "durationSec": 3.648
    },
    {
      "index": 21,
      "text": "Descanse en conciencia abierta por un momento.",
      "file": "c021.ogg",
      "durationSec": 5.928
    },
    {
      "index": 22,
      "text": "Cuando esté listo, abre los ojos.",
      "file": "c022.ogg",
      "durationSec": 5.208
    }
  ]
}
