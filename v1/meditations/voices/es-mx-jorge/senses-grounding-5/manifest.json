{
  "id": "senses-grounding-5",
  "voiceId": "es-mx-jorge",
  "edgeVoice": "es-MX-JorgeNeural",
  "rate": "-42%",
  "pitch": "-12Hz",
  "totalSec": 140,
  "chunks": [
    {
      "index": 0,
      "text": "Bienvenido.",
      "file": "c000.ogg",
      "durationSec": 2.88
    },
    {
      "index": 1,
      "text": "Si te sientes disperso o activado, esta práctica puede ayudarte.",
      "file": "c001.ogg",
      "durationSec": 8.472
    },
    {
      "index": 2,
      "text": "Mantenga los ojos abiertos por ahora, si le parece más seguro.",
      "file": "c002.ogg",
      "durationSec": 7.8
    },
    {
      "index": 3,
      "text": "Planta ambos pies en el suelo.",
      "file": "c003.ogg",
      "durationSec": 4.56
    },
    {
      "index": 4,
      "text": "[pausa:17]",
      "file": "c004.ogg",
      "durationSec": 4.056
    },
    {
      "index": 5,
      "text": "Nombra cinco cosas que puedas ver.",
      "file": "c005.ogg",
      "durationSec": 4.992
    },
    {
      "index": 6,
      "text": "En silencio. Tome su tiempo.",
      "file": "c006.ogg",
      "durationSec": 6.024
    },
    {
      "index": 7,
      "text": "[pausa:45]",
      "file": "c007.ogg",
      "durationSec": 4.464
    },
    {
      "index": 8,
      "text": "Nombra cuatro cosas que puedas sentir o tocar.",
      "file": "c008.ogg",
      "durationSec": 5.928
    },
    {
      "index": 9,
      "text": "Ropa. Silla. Aire sobre la piel. Pies en el suelo.",
      "file": "c009.ogg",
      "durationSec": 11.52
    },
    {
      "index": 10,
      "text": "[pausa:39]",
      "file": "c010.ogg",
      "durationSec": 4.272
    },
    {
      "index": 11,
      "text": "Nombra tres sonidos.",
      "file": "c011.ogg",
      "durationSec": 3.816
    },
    {
      "index": 12,
      "text": "Cerca o lejos. Suave o claro.",
      "file": "c012.ogg",
      "durationSec": 6.672
    },
    {
      "index": 13,
      "text": "[pausa:39]",
      "file": "c013.ogg",
      "durationSec": 4.272
    },
    {
      "index": 14,
      "text": "Nombra dos aromas o simplemente observa la calidad del aire.",
      "file": "c014.ogg",
      "durationSec": 7.272
    },
    {
      "index": 15,
      "text": "[pausa:28]",
      "file": "c015.ogg",
      "durationSec": 4.008
    },
    {
      "index": 16,
      "text": "Nombra un sabor o sensación dentro de la boca.",
      "file": "c016.ogg",
      "durationSec": 5.856
    },
    {
      "index": 17,
      "text": "[pausa:23]",
      "file": "c017.ogg",
      "durationSec": 4.152
    },
    {
      "index": 18,
      "text": "Usted está aquí. En este cuerpo. En esta sala.",
      "file": "c018.ogg",
      "durationSec": 9.288
    },
    {
      "index": 19,
      "text": "Inhale por cuatro.",
      "file": "c019.ogg",
      "durationSec": 3.528
    },
    {
      "index": 20,
      "text": "Fuera por seis.",
      "file": "c020.ogg",
      "durationSec": 3.432
    },
    {
      "index": 21,
      "text": "[pausa:23]",
      "file": "c021.ogg",
      "durationSec": 4.152
    },
    {
      "index": 22,
      "text": "Respira tranquilamente una vez más.",
      "file": "c022.ogg",
      "durationSec": 5.376
    },
    {
      "index": 23,
      "text": "Mueve los dedos.",
      "file": "c023.ogg",
      "durationSec": 3.288
    },
    {
      "index": 24,
      "text": "Cuando estés listo, abre los ojos.",
      "file": "c024.ogg",
      "durationSec": 5.352
    },
    {
      "index": 25,
      "text": "Lleva un poco de esto contigo.",
      "file": "c025.ogg",
      "durationSec": 4.704
    }
  ]
}
