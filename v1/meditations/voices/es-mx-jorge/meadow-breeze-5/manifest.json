{
  "id": "meadow-breeze-5",
  "voiceId": "es-mx-jorge",
  "edgeVoice": "es-MX-JorgeNeural",
  "rate": "-42%",
  "pitch": "-12Hz",
  "totalSec": 355,
  "chunks": [
    {
      "index": 0,
      "text": "Bienvenido.",
      "file": "c000.ogg",
      "durationSec": 2.88
    },
    {
      "index": 1,
      "text": "Tome un asiento cómodo o acuéstese si se siente mejor.",
      "file": "c001.ogg",
      "durationSec": 7.056
    },
    {
      "index": 2,
      "text": "Deja que tus manos descansen.",
      "file": "c002.ogg",
      "durationSec": 4.56
    },
    {
      "index": 3,
      "text": "Deja que tus ojos se cierren o suaviza tu mirada.",
      "file": "c003.ogg",
      "durationSec": 6.36
    },
    {
      "index": 4,
      "text": "Observe el peso de su cuerpo que se sostiene.",
      "file": "c004.ogg",
      "durationSec": 5.712
    },
    {
      "index": 5,
      "text": "Respire lentamente por la nariz.",
      "file": "c005.ogg",
      "durationSec": 4.944
    },
    {
      "index": 6,
      "text": "Y una exhalación más larga y más fácil.",
      "file": "c006.ogg",
      "durationSec": 5.616
    },
    {
      "index": 7,
      "text": "De nuevo. Inhala suavemente.",
      "file": "c007.ogg",
      "durationSec": 6.216
    },
    {
      "index": 8,
      "text": "Exhala suavemente.",
      "file": "c008.ogg",
      "durationSec": 3.696
    },
    {
      "index": 9,
      "text": "Si los pensamientos divagan, está bien. Vuelve a la respiración.",
      "file": "c009.ogg",
      "durationSec": 9.432
    },
    {
      "index": 10,
      "text": "Imagínese una amplia pradera de montaña al final de la mañana.",
      "file": "c010.ogg",
      "durationSec": 7.656
    },
    {
      "index": 11,
      "text": "Los pastos altos se mecen en suaves olas.",
      "file": "c011.ogg",
      "durationSec": 5.736
    },
    {
      "index": 12,
      "text": "El sol calienta sin ser fuerte.",
      "file": "c012.ogg",
      "durationSec": 4.848
    },
    {
      "index": 13,
      "text": "Siéntelo en la coronilla de tu cabeza, amable y firme.",
      "file": "c013.ogg",
      "durationSec": 7.008
    },
    {
      "index": 14,
      "text": "Una brisa fresca se mueve entre la hierba y encuentra tu rostro.",
      "file": "c014.ogg",
      "durationSec": 7.464
    },
    {
      "index": 15,
      "text": "Huele a flores silvestres y a tierra secada al sol.",
      "file": "c015.ogg",
      "durationSec": 6.336
    },
    {
      "index": 16,
      "text": "Caminas lentamente, rozando las cabezas de las semillas con las yemas de los dedos.",
      "file": "c016.ogg",
      "durationSec": 9.6
    },
    {
      "index": 17,
      "text": "Cosquillas suaves. Sonido suave.",
      "file": "c017.ogg",
      "durationSec": 6.576
    },
    {
      "index": 18,
      "text": "Las mariposas se elevan y se posan nuevamente, sin prisas.",
      "file": "c018.ogg",
      "durationSec": 7.704
    },
    {
      "index": 19,
      "text": "Encuentra un lugar para recostarse en la hierba.",
      "file": "c019.ogg",
      "durationSec": 5.736
    },
    {
      "index": 20,
      "text": "La tierra sostiene toda tu longitud.",
      "file": "c020.ogg",
      "durationSec": 5.328
    },
    {
      "index": 21,
      "text": "Calidez a lo largo de tu frente. Sombra de tierra fresca a tus lados.",
      "file": "c021.ogg",
      "durationSec": 9.648
    },
    {
      "index": 22,
      "text": "La brisa va y viene como una marea amiga.",
      "file": "c022.ogg",
      "durationSec": 5.688
    },
    {
      "index": 23,
      "text": "Inhala frescura. Exhala hacia el cielo abierto.",
      "file": "c023.ogg",
      "durationSec": 7.776
    },
    {
      "index": 24,
      "text": "Una nube se desliza por el sol por un momento.",
      "file": "c024.ogg",
      "durationSec": 6.024
    },
    {
      "index": 25,
      "text": "Frescura. Luego el calor regresa a tu rostro.",
      "file": "c025.ogg",
      "durationSec": 7.56
    },
    {
      "index": 26,
      "text": "Observe cuán grande se siente el silencio.",
      "file": "c026.ogg",
      "durationSec": 5.544
    },
    {
      "index": 27,
      "text": "Qué pequeña parece cualquier preocupación en este amplio campo.",
      "file": "c027.ogg",
      "durationSec": 7.2
    },
    {
      "index": 28,
      "text": "Tus manos descansan en la hierba. Los tallos diminutos se presionan amablemente.",
      "file": "c028.ogg",
      "durationSec": 10.32
    },
    {
      "index": 29,
      "text": "Quédate con el calor del sol en tus ojos cerrados.",
      "file": "c029.ogg",
      "durationSec": 6.216
    },
    {
      "index": 30,
      "text": "Quédate con la suave presión del césped contra tus brazos.",
      "file": "c030.ogg",
      "durationSec": 6.792
    },
    {
      "index": 31,
      "text": "Se te permite estar así de quieto.",
      "file": "c031.ogg",
      "durationSec": 4.968
    },
    {
      "index": 32,
      "text": "Deja que la pradera te respire durante unos ciclos más.",
      "file": "c032.ogg",
      "durationSec": 6.984
    },
    {
      "index": 33,
      "text": "Desvía tu atención desde la cálida coronilla de la cabeza.",
      "file": "c033.ogg",
      "durationSec": 6.96
    },
    {
      "index": 34,
      "text": "A través de un rostro suave, una garganta suave,",
      "file": "c034.ogg",
      "durationSec": 6.504
    },
    {
      "index": 35,
      "text": "en un cofre que se eleva fácilmente a cielo abierto.",
      "file": "c035.ogg",
      "durationSec": 6.432
    },
    {
      "index": 36,
      "text": "La brisa encuentra el interior de tus muñecas.",
      "file": "c036.ogg",
      "durationSec": 5.808
    },
    {
      "index": 37,
      "text": "Fresco. Vivo. Amigable.",
      "file": "c037.ogg",
      "durationSec": 7.584
    },
    {
      "index": 38,
      "text": "En algún lugar las abejas trabajan sin urgencia.",
      "file": "c038.ogg",
      "durationSec": 6.264
    },
    {
      "index": 39,
      "text": "Su zumbido es otro tipo de silencio.",
      "file": "c039.ogg",
      "durationSec": 5.328
    },
    {
      "index": 40,
      "text": "Quédese hasta que la calidez y la frescura se sientan como una sola tela.",
      "file": "c040.ogg",
      "durationSec": 8.232
    },
    {
      "index": 41,
      "text": "Ahora descansa un rato en la respiración a solas.",
      "file": "c041.ogg",
      "durationSec": 6.36
    },
    {
      "index": 42,
      "text": "Inhala lentamente.",
      "file": "c042.ogg",
      "durationSec": 3.696
    },
    {
      "index": 43,
      "text": "Exhala lentamente.",
      "file": "c043.ogg",
      "durationSec": 3.768
    },
    {
      "index": 44,
      "text": "Inhalar.",
      "file": "c044.ogg",
      "durationSec": 2.76
    },
    {
      "index": 45,
      "text": "Exhalar.",
      "file": "c045.ogg",
      "durationSec": 2.832
    },
    {
      "index": 46,
      "text": "Siente calidez dondequiera que el cuerpo esté caliente.",
      "file": "c046.ogg",
      "durationSec": 6.696
    },
    {
      "index": 47,
      "text": "Siente frescura dondequiera que el aire esté fresco.",
      "file": "c047.ogg",
      "durationSec": 6.552
    },
    {
      "index": 48,
      "text": "Inhalar.",
      "file": "c048.ogg",
      "durationSec": 2.76
    },
    {
      "index": 49,
      "text": "Exhalar.",
      "file": "c049.ogg",
      "durationSec": 2.832
    },
    {
      "index": 50,
      "text": "Ningún lugar adonde ir. Nada que arreglar.",
      "file": "c050.ogg",
      "durationSec": 7.464
    },
    {
      "index": 51,
      "text": "Inhalar.",
      "file": "c051.ogg",
      "durationSec": 2.76
    },
    {
      "index": 52,
      "text": "Exhalar.",
      "file": "c052.ogg",
      "durationSec": 2.832
    },
    {
      "index": 53,
      "text": "Descanse aquí durante unas cuantas respiraciones tranquilas.",
      "file": "c053.ogg",
      "durationSec": 7.368
    },
    {
      "index": 54,
      "text": "Sepa que puede regresar a este lugar en cualquier momento.",
      "file": "c054.ogg",
      "durationSec": 6.936
    },
    {
      "index": 55,
      "text": "Cuando estés listo, profundiza la respiración.",
      "file": "c055.ogg",
      "durationSec": 6.456
    },
    {
      "index": 56,
      "text": "Mueve los dedos de las manos y de los pies.",
      "file": "c056.ogg",
      "durationSec": 5.472
    },
    {
      "index": 57,
      "text": "Abre los ojos suavemente.",
      "file": "c057.ogg",
      "durationSec": 4.224
    },
    {
      "index": 58,
      "text": "Lleva un poco de esta paz contigo.",
      "file": "c058.ogg",
      "durationSec": 5.04
    }
  ]
}
