{
  "id": "anxiety-ease-10",
  "voiceId": "es-mx-jorge",
  "edgeVoice": "es-MX-JorgeNeural",
  "rate": "-42%",
  "pitch": "-12Hz",
  "totalSec": 257,
  "chunks": [
    {
      "index": 0,
      "text": "Bienvenido.",
      "file": "c000.ogg",
      "durationSec": 2.88
    },
    {
      "index": 1,
      "text": "Tómese el tiempo para llegar.",
      "file": "c001.ogg",
      "durationSec": 4.296
    },
    {
      "index": 2,
      "text": "Siéntate o acuéstate con apoyo.",
      "file": "c002.ogg",
      "durationSec": 5.016
    },
    {
      "index": 3,
      "text": "Cierra los ojos si te sientes seguro.",
      "file": "c003.ogg",
      "durationSec": 5.16
    },
    {
      "index": 4,
      "text": "Siente el contacto con el suelo.",
      "file": "c004.ogg",
      "durationSec": 4.68
    },
    {
      "index": 5,
      "text": "Inhale lentamente.",
      "file": "c005.ogg",
      "durationSec": 3.72
    },
    {
      "index": 6,
      "text": "Exhale más tiempo.",
      "file": "c006.ogg",
      "durationSec": 3.624
    },
    {
      "index": 7,
      "text": "[pausa:20]",
      "file": "c007.ogg",
      "durationSec": 3.672
    },
    {
      "index": 8,
      "text": "De nuevo.",
      "file": "c008.ogg",
      "durationSec": 2.64
    },
    {
      "index": 9,
      "text": "[pausa:20]",
      "file": "c009.ogg",
      "durationSec": 3.672
    },
    {
      "index": 10,
      "text": "Deja caer los hombros.",
      "file": "c010.ogg",
      "durationSec": 4.08
    },
    {
      "index": 11,
      "text": "Deja que la barriga se ablande.",
      "file": "c011.ogg",
      "durationSec": 4.512
    },
    {
      "index": 12,
      "text": "[pausa:25]",
      "file": "c012.ogg",
      "durationSec": 4.104
    },
    {
      "index": 13,
      "text": "Es posible que la ansiedad todavía esté aquí. Eso está permitido.",
      "file": "c013.ogg",
      "durationSec": 9.264
    },
    {
      "index": 14,
      "text": "No estamos luchando contra ello. Nos estamos haciendo amigos del cuerpo.",
      "file": "c014.ogg",
      "durationSec": 9.72
    },
    {
      "index": 15,
      "text": "[pausa:25]",
      "file": "c015.ogg",
      "durationSec": 4.104
    },
    {
      "index": 16,
      "text": "Presione los pies suavemente contra el suelo.",
      "file": "c016.ogg",
      "durationSec": 5.592
    },
    {
      "index": 17,
      "text": "Siente cómo el suelo presiona hacia atrás.",
      "file": "c017.ogg",
      "durationSec": 5.712
    },
    {
      "index": 18,
      "text": "[pausa:25]",
      "file": "c018.ogg",
      "durationSec": 4.104
    },
    {
      "index": 19,
      "text": "Nombra tres cosas que puedas ver con los ojos cerrados o con la mirada suave.",
      "file": "c019.ogg",
      "durationSec": 8.424
    },
    {
      "index": 20,
      "text": "Oscuro. Luz. Forma de los párpados.",
      "file": "c020.ogg",
      "durationSec": 8.904
    },
    {
      "index": 21,
      "text": "[pausa:25]",
      "file": "c021.ogg",
      "durationSec": 4.104
    },
    {
      "index": 22,
      "text": "Nombra tres sensaciones.",
      "file": "c022.ogg",
      "durationSec": 4.2
    },
    {
      "index": 23,
      "text": "Ropa. Temperatura. Aliento.",
      "file": "c023.ogg",
      "durationSec": 7.92
    },
    {
      "index": 24,
      "text": "[pausa:25]",
      "file": "c024.ogg",
      "durationSec": 4.104
    },
    {
      "index": 25,
      "text": "Inhale por cuatro.",
      "file": "c025.ogg",
      "durationSec": 3.528
    },
    {
      "index": 26,
      "text": "Espera por dos.",
      "file": "c026.ogg",
      "durationSec": 3.48
    },
    {
      "index": 27,
      "text": "Fuera por seis.",
      "file": "c027.ogg",
      "durationSec": 3.432
    },
    {
      "index": 28,
      "text": "[pausa:20]",
      "file": "c028.ogg",
      "durationSec": 3.672
    },
    {
      "index": 29,
      "text": "De nuevo.",
      "file": "c029.ogg",
      "durationSec": 2.64
    },
    {
      "index": 30,
      "text": "[pausa:25]",
      "file": "c030.ogg",
      "durationSec": 4.104
    },
    {
      "index": 31,
      "text": "Coloque una mano sobre el pecho o el vientre.",
      "file": "c031.ogg",
      "durationSec": 5.88
    },
    {
      "index": 32,
      "text": "Siente el movimiento debajo de la mano.",
      "file": "c032.ogg",
      "durationSec": 5.304
    },
    {
      "index": 33,
      "text": "Di en voz baja: ahora mismo estoy respirando.",
      "file": "c033.ogg",
      "durationSec": 6.624
    },
    {
      "index": 34,
      "text": "[pausa:30]",
      "file": "c034.ogg",
      "durationSec": 3.816
    },
    {
      "index": 35,
      "text": "Si la mente se adelanta, agradécele por intentar protegerte.",
      "file": "c035.ogg",
      "durationSec": 8.04
    },
    {
      "index": 36,
      "text": "Luego regresa a esta respiración.",
      "file": "c036.ogg",
      "durationSec": 5.16
    },
    {
      "index": 37,
      "text": "[pausa:41]",
      "file": "c037.ogg",
      "durationSec": 4.272
    },
    {
      "index": 38,
      "text": "Escanea la cara. Ablandar.",
      "file": "c038.ogg",
      "durationSec": 6.216
    },
    {
      "index": 39,
      "text": "Escanea las manos. Ablandar.",
      "file": "c039.ogg",
      "durationSec": 6.576
    },
    {
      "index": 40,
      "text": "[pausa:30]",
      "file": "c040.ogg",
      "durationSec": 3.816
    },
    {
      "index": 41,
      "text": "Descanse al ritmo de exhalaciones más largas.",
      "file": "c041.ogg",
      "durationSec": 6.24
    },
    {
      "index": 42,
      "text": "[pausa:76]",
      "file": "c042.ogg",
      "durationSec": 4.632
    },
    {
      "index": 43,
      "text": "Le has dado al sistema nervioso una orilla más amplia.",
      "file": "c043.ogg",
      "durationSec": 6.744
    },
    {
      "index": 44,
      "text": "[pausa:41]",
      "file": "c044.ogg",
      "durationSec": 4.272
    },
    {
      "index": 45,
      "text": "[pausa:30]",
      "file": "c045.ogg",
      "durationSec": 3.816
    },
    {
      "index": 46,
      "text": "Comience a profundizar la respiración.",
      "file": "c046.ogg",
      "durationSec": 5.208
    },
    {
      "index": 47,
      "text": "Siente la habitación de nuevo.",
      "file": "c047.ogg",
      "durationSec": 4.488
    },
    {
      "index": 48,
      "text": "Mueve los dedos de las manos y de los pies.",
      "file": "c048.ogg",
      "durationSec": 5.472
    },
    {
      "index": 49,
      "text": "Cuando esté listo, abre los ojos.",
      "file": "c049.ogg",
      "durationSec": 5.208
    },
    {
      "index": 50,
      "text": "Avance lentamente hacia lo que viene a continuación.",
      "file": "c050.ogg",
      "durationSec": 6.168
    }
  ]
}
