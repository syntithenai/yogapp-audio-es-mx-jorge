{
  "id": "evening-unload-10",
  "voiceId": "es-mx-jorge",
  "edgeVoice": "es-MX-JorgeNeural",
  "rate": "-42%",
  "pitch": "-12Hz",
  "totalSec": 187,
  "chunks": [
    {
      "index": 0,
      "text": "Bienvenido.",
      "file": "c000.ogg",
      "durationSec": 2.88
    },
    {
      "index": 1,
      "text": "Tómese el tiempo para llegar.",
      "file": "c001.ogg",
      "durationSec": 4.296
    },
    {
      "index": 2,
      "text": "Siéntate o acuéstate con apoyo.",
      "file": "c002.ogg",
      "durationSec": 5.016
    },
    {
      "index": 3,
      "text": "Cierra los ojos si te sientes seguro.",
      "file": "c003.ogg",
      "durationSec": 5.16
    },
    {
      "index": 4,
      "text": "Siente el contacto con el suelo.",
      "file": "c004.ogg",
      "durationSec": 4.68
    },
    {
      "index": 5,
      "text": "Inhale lentamente.",
      "file": "c005.ogg",
      "durationSec": 3.72
    },
    {
      "index": 6,
      "text": "Exhale más tiempo.",
      "file": "c006.ogg",
      "durationSec": 3.624
    },
    {
      "index": 7,
      "text": "[pausa:26]",
      "file": "c007.ogg",
      "durationSec": 4.224
    },
    {
      "index": 8,
      "text": "De nuevo.",
      "file": "c008.ogg",
      "durationSec": 2.64
    },
    {
      "index": 9,
      "text": "[pausa:26]",
      "file": "c009.ogg",
      "durationSec": 4.224
    },
    {
      "index": 10,
      "text": "Deja caer los hombros.",
      "file": "c010.ogg",
      "durationSec": 4.08
    },
    {
      "index": 11,
      "text": "Deja que la barriga se ablande.",
      "file": "c011.ogg",
      "durationSec": 4.512
    },
    {
      "index": 12,
      "text": "[pausa:33]",
      "file": "c012.ogg",
      "durationSec": 4.512
    },
    {
      "index": 13,
      "text": "Que el día termine por ahora.",
      "file": "c013.ogg",
      "durationSec": 4.32
    },
    {
      "index": 14,
      "text": "Lo que pasó, pasó.",
      "file": "c014.ogg",
      "durationSec": 4.056
    },
    {
      "index": 15,
      "text": "Lo que quede puede esperar hasta la mañana.",
      "file": "c015.ogg",
      "durationSec": 5.256
    },
    {
      "index": 16,
      "text": "[pausa:33]",
      "file": "c016.ogg",
      "durationSec": 4.512
    },
    {
      "index": 17,
      "text": "Al exhalar, imagina colocar tareas en un estante.",
      "file": "c017.ogg",
      "durationSec": 7.152
    },
    {
      "index": 18,
      "text": "Uno por uno. Sin dramatismo. Sólo siéntate.",
      "file": "c018.ogg",
      "durationSec": 9.36
    },
    {
      "index": 19,
      "text": "[pausa:53]",
      "file": "c019.ogg",
      "durationSec": 4.656
    },
    {
      "index": 20,
      "text": "Inhala cuatro. Exhala seis.",
      "file": "c020.ogg",
      "durationSec": 6.48
    },
    {
      "index": 21,
      "text": "[pausa:33]",
      "file": "c021.ogg",
      "durationSec": 4.512
    },
    {
      "index": 22,
      "text": "Suaviza el rostro.",
      "file": "c022.ogg",
      "durationSec": 3.528
    },
    {
      "index": 23,
      "text": "Deja caer los hombros.",
      "file": "c023.ogg",
      "durationSec": 4.08
    },
    {
      "index": 24,
      "text": "Armas pesadas. Piernas pesadas.",
      "file": "c024.ogg",
      "durationSec": 6.888
    },
    {
      "index": 25,
      "text": "[pausa:40]",
      "file": "c025.ogg",
      "durationSec": 3.888
    },
    {
      "index": 26,
      "text": "Si la mente vuelve a hacer una lista, asiente y regresa al estante.",
      "file": "c026.ogg",
      "durationSec": 8.352
    },
    {
      "index": 27,
      "text": "[pausa:53]",
      "file": "c027.ogg",
      "durationSec": 4.656
    },
    {
      "index": 28,
      "text": "Siente el colchón o la silla que te sostiene.",
      "file": "c028.ogg",
      "durationSec": 5.712
    },
    {
      "index": 29,
      "text": "[pausa:66]",
      "file": "c029.ogg",
      "durationSec": 4.656
    },
    {
      "index": 30,
      "text": "Respira más tranquilo. Cuerpo más pesado.",
      "file": "c030.ogg",
      "durationSec": 7.392
    },
    {
      "index": 31,
      "text": "[pausa:90]",
      "file": "c031.ogg",
      "durationSec": 3.768
    },
    {
      "index": 32,
      "text": "[pausa:40]",
      "file": "c032.ogg",
      "durationSec": 3.888
    },
    {
      "index": 33,
      "text": "Comience a profundizar la respiración.",
      "file": "c033.ogg",
      "durationSec": 5.208
    },
    {
      "index": 34,
      "text": "Siente la habitación de nuevo.",
      "file": "c034.ogg",
      "durationSec": 4.488
    },
    {
      "index": 35,
      "text": "Mueve los dedos de las manos y de los pies.",
      "file": "c035.ogg",
      "durationSec": 5.472
    },
    {
      "index": 36,
      "text": "Cuando esté listo, abre los ojos.",
      "file": "c036.ogg",
      "durationSec": 5.208
    },
    {
      "index": 37,
      "text": "Avance lentamente hacia lo que viene a continuación.",
      "file": "c037.ogg",
      "durationSec": 6.168
    }
  ]
}
