{
  "id": "gratitude-expand-10",
  "voiceId": "es-mx-jorge",
  "edgeVoice": "es-MX-JorgeNeural",
  "rate": "-42%",
  "pitch": "-12Hz",
  "totalSec": 189,
  "chunks": [
    {
      "index": 0,
      "text": "Bienvenido.",
      "file": "c000.ogg",
      "durationSec": 2.88
    },
    {
      "index": 1,
      "text": "Tómese el tiempo para llegar.",
      "file": "c001.ogg",
      "durationSec": 4.296
    },
    {
      "index": 2,
      "text": "Siéntate o acuéstate con apoyo.",
      "file": "c002.ogg",
      "durationSec": 5.016
    },
    {
      "index": 3,
      "text": "Cierra los ojos si te sientes seguro.",
      "file": "c003.ogg",
      "durationSec": 5.16
    },
    {
      "index": 4,
      "text": "Siente el contacto con el suelo.",
      "file": "c004.ogg",
      "durationSec": 4.68
    },
    {
      "index": 5,
      "text": "Inhale lentamente.",
      "file": "c005.ogg",
      "durationSec": 3.72
    },
    {
      "index": 6,
      "text": "Exhale más tiempo.",
      "file": "c006.ogg",
      "durationSec": 3.624
    },
    {
      "index": 7,
      "text": "[pausa:27]",
      "file": "c007.ogg",
      "durationSec": 4.104
    },
    {
      "index": 8,
      "text": "De nuevo.",
      "file": "c008.ogg",
      "durationSec": 2.64
    },
    {
      "index": 9,
      "text": "[pausa:27]",
      "file": "c009.ogg",
      "durationSec": 4.104
    },
    {
      "index": 10,
      "text": "Deja caer los hombros.",
      "file": "c010.ogg",
      "durationSec": 4.08
    },
    {
      "index": 11,
      "text": "Deja que la barriga se ablande.",
      "file": "c011.ogg",
      "durationSec": 4.512
    },
    {
      "index": 12,
      "text": "[pausa:34]",
      "file": "c012.ogg",
      "durationSec": 4.344
    },
    {
      "index": 13,
      "text": "Comience con un pequeño bien concreto.",
      "file": "c013.ogg",
      "durationSec": 5.304
    },
    {
      "index": 14,
      "text": "Sostenlo. Gracias.",
      "file": "c014.ogg",
      "durationSec": 5.52
    },
    {
      "index": 15,
      "text": "[pausa:40]",
      "file": "c015.ogg",
      "durationSec": 3.888
    },
    {
      "index": 16,
      "text": "Un segundo. Una persona, lugar o comodidad.",
      "file": "c016.ogg",
      "durationSec": 8.088
    },
    {
      "index": 17,
      "text": "Gracias.",
      "file": "c017.ogg",
      "durationSec": 2.856
    },
    {
      "index": 18,
      "text": "[pausa:40]",
      "file": "c018.ogg",
      "durationSec": 3.888
    },
    {
      "index": 19,
      "text": "Un tercero. Algo en tu cuerpo que funciona hoy.",
      "file": "c019.ogg",
      "durationSec": 7.464
    },
    {
      "index": 20,
      "text": "Gracias.",
      "file": "c020.ogg",
      "durationSec": 2.856
    },
    {
      "index": 21,
      "text": "[pausa:40]",
      "file": "c021.ogg",
      "durationSec": 3.888
    },
    {
      "index": 22,
      "text": "Amplíe su atención a las personas que han sido amables, aunque sea brevemente.",
      "file": "c022.ogg",
      "durationSec": 9.096
    },
    {
      "index": 23,
      "text": "[pausa:54]",
      "file": "c023.ogg",
      "durationSec": 4.536
    },
    {
      "index": 24,
      "text": "Ampliarse hasta el lugar en el que se encuentra. Refugio. Aire. Suelo.",
      "file": "c024.ogg",
      "durationSec": 13.056
    },
    {
      "index": 25,
      "text": "[pausa:54]",
      "file": "c025.ogg",
      "durationSec": 4.536
    },
    {
      "index": 26,
      "text": "Si la gratitud le resulta difícil, agradezca el esfuerzo de presentarse.",
      "file": "c026.ogg",
      "durationSec": 9.168
    },
    {
      "index": 27,
      "text": "Eso cuenta.",
      "file": "c027.ogg",
      "durationSec": 2.952
    },
    {
      "index": 28,
      "text": "[pausa:40]",
      "file": "c028.ogg",
      "durationSec": 3.888
    },
    {
      "index": 29,
      "text": "Descanse en cualquier calidez que surgiera.",
      "file": "c029.ogg",
      "durationSec": 5.568
    },
    {
      "index": 30,
      "text": "O descansar en la intención misma.",
      "file": "c030.ogg",
      "durationSec": 4.896
    },
    {
      "index": 31,
      "text": "[pausa:90]",
      "file": "c031.ogg",
      "durationSec": 3.768
    },
    {
      "index": 32,
      "text": "[pausa:40]",
      "file": "c032.ogg",
      "durationSec": 3.888
    },
    {
      "index": 33,
      "text": "Comience a profundizar la respiración.",
      "file": "c033.ogg",
      "durationSec": 5.208
    },
    {
      "index": 34,
      "text": "Siente la habitación de nuevo.",
      "file": "c034.ogg",
      "durationSec": 4.488
    },
    {
      "index": 35,
      "text": "Mueve los dedos de las manos y de los pies.",
      "file": "c035.ogg",
      "durationSec": 5.472
    },
    {
      "index": 36,
      "text": "Cuando esté listo, abre los ojos.",
      "file": "c036.ogg",
      "durationSec": 5.208
    },
    {
      "index": 37,
      "text": "Avance lentamente hacia lo que viene a continuación.",
      "file": "c037.ogg",
      "durationSec": 6.168
    }
  ]
}
